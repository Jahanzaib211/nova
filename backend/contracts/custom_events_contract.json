{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nova custom-event wire contract",
  "description": "Shape of the four custom-event payloads the gateway emits over the SSE `custom` stream mode. Pinned by backend/tests/test_custom_events_contract.py and frontend/tests/unit/core/threads/custom-event-contract.test.ts so any drift in either side fails the build.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_progress", "verify_result", "llm_error", "task_running"],
  "properties": {
    "task_progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "step", "total", "status"],
      "properties": {
        "type": {"const": "task_progress"},
        "step": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "status": {"enum": ["pending", "in_progress", "completed"]}
      }
    },
    "verify_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ok", "routes"],
      "properties": {
        "type": {"const": "verify_result"},
        "ok": {"type": "boolean"},
        "verdict": {"type": "string"},
        "routes": {"type": "array"},
        "console_errors_count": {"type": "integer", "minimum": 0},
        "screenshot": {"type": ["string", "null"]},
        "thread_id": {"type": "string"}
      }
    },
    "llm_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "error_type"],
      "properties": {
        "type": {"const": "llm_error"},
        "error_type": {"type": "string"},
        "reason": {"type": "string"},
        "detail": {"type": "string"},
        "http_status": {"type": "integer"},
        "code": {"type": "string"}
      }
    },
    "task_running": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id"],
      "properties": {
        "type": {"const": "task_running"},
        "task_id": {"type": "string"},
        "message": {"type": "object"}
      }
    }
  }
}