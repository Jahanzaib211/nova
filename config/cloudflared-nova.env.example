# Cloudflare Tunnel token for nova-hackathon.
# Source: Cloudflare dashboard → Zero Trust → Networks → Tunnels →
#         Nova hackathon → Configure → Token.
#
# This file MUST stay mode 0600 (root only). systemd reads it via
# EnvironmentFile= in cloudflared-nova.service.
#
# To rotate: paste the new token below and `sudo systemctl restart cloudflared-nova`.
TUNNEL_TOKEN=<paste-tunnel-token-here>