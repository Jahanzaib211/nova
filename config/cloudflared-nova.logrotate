# Logrotate config for Cloudflare Tunnel Nova — enterprise-grade rotation.
#
# cloudflared's stdout/stderr go to journald (via systemd), but the PM2
# wrapper and the healthcheck probe also write to flat files under
# /var/log/cloudflared. Rotation policy:
#   - daily, keep 14 days (matches nova-healthcheck retention)
#   - compress with gzip, keep one uncompressed for `tail -f` convenience
#   - postrotate: send SIGHUP so cloudflared reopens its log file
#     (cloudflared handles SIGHUP gracefully; it doesn't tear down tunnels)
/var/log/cloudflared/nova-*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
    dateformat -%Y%m%d
    extension .log
    create 0640 root adm
    sharedscripts
    postrotate
        # SIGHUP = graceful log reopen; SIGUSR1 = metrics dump. We use HUP
        # because the tunnel shouldn't drop on log rotation.
        if [ -f /var/run/cloudflared-nova.pid ]; then
            kill -HUP "$(cat /var/run/cloudflared-nova.pid)" 2>/dev/null || true
        fi
        # Also nudge pm2 to flush its tail cache.
        if command -v pm2 >/dev/null 2>&1; then
            pm2 reloadLogs >/dev/null 2>&1 || true
        fi
    endscript
}