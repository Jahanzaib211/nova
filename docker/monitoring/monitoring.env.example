# Nova monitoring secrets — loaded by pm2-monitoring.sh and docker compose.
# MODE 0600 — never commit this file.
#
# Generate a strong password:
#   openssl rand -base64 24
#
# For Cloudflare Access (optional):
#   Create a Cloudflare Access application at:
#   dash.cloudflare.com → Zero Trust → Networks → Access → Applications
#   Set the AUD tag to the value shown in the application settings.
#
# For ntfy push alerts (optional, free):
#   ntfy.sh lets you push to any topic without auth.
#   Set NTFY_TOPIC to a random string, then subscribe in the ntfy app.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_to_a_random_string
GRAFANA_ROOT_URL=http://127.0.0.1:3002

# Cloudflare Access — leave blank to disable public access (LAN-only)
CLOUDFLARE_ACCESS_AUD=

# ntfy.sh push alerts — leave blank to disable push
NTFY_TOPIC=nova-alerts-change-me
