# Layer 1/4 — the pinned foundation.
#
# Nova's sandbox is the agent's entire world, so it must not change underneath
# us. Until now every layer built `FROM …/all-in-one-sandbox:latest`, a moving
# tag: two builds a week apart could produce two different sandboxes with no
# change in this repo and nothing to point at when behaviour drifted.
#
# Pinning the digest is what makes `make sandbox-image` reproducible. To adopt a
# new upstream, re-pull the tag, read the new digest, and change it *here* in one
# reviewable line — deliberately, not by accident.
#
#   docker pull …/all-in-one-sandbox:latest
#   docker inspect --format '{{index .RepoDigests 0}}' …/all-in-one-sandbox:latest
#
# Pinned 2026-08-21. Base is Ubuntu 22.04 (glibc 2.35) — see Dockerfile.tools
# for why that number governs what may be copied in from the host.
FROM enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox@sha256:742062f99915e5495df8d4bfeaf40a93197c87c7c47b4e2407cd2b6356df8f48

LABEL org.nova.sandbox.layer="base" \
      org.nova.sandbox.upstream="all-in-one-sandbox" \
      org.nova.sandbox.upstream-digest="sha256:742062f99915e5495df8d4bfeaf40a93197c87c7c47b4e2407cd2b6356df8f48"
