# Layer 3/4 — a real Docker daemon inside the sandbox.
#
# This is the capability that turns the sandbox from "somewhere to run scripts"
# into "somewhere to stand up a Postgres and test against it". It requires the
# container to run with --privileged, which is gated behind `sandbox.privileged`
# in config.yaml and is OFF by default: a privileged container is effectively
# host root, and this layer being present in the image does not by itself grant
# anything — the flag does.
#
# The daemon binaries are copied from the build host rather than installed from
# Docker's apt repo, because they are already here and ABI-compatible: dockerd,
# containerd, docker and docker-proxy need glibc 2.34 against this image's 2.35,
# and containerd-shim-runc-v2 is static. runc is the single exception — the
# host's build needs glibc 2.38 — so it is the one piece downloaded, as an
# official static binary of a few megabytes.
ARG BASE=nova-sandbox-tools:latest
FROM ${BASE}

LABEL org.nova.sandbox.layer="dind"

ARG RUNC_VERSION=v1.2.3
ARG DEBIAN_FRONTEND=noninteractive

# nftables is the daemon's own dependency, not general tooling, which is why it
# lives here rather than in the tools layer — putting it there would invalidate
# every layer below it for a package only dockerd uses. Without `nft` the daemon
# starts but logs "Failed to find nft tool" and falls back to legacy iptables
# for every rule it manages.
RUN apt-get update && apt-get install -y --no-install-recommends nftables \
    && rm -rf /var/lib/apt/lists/*

# vendor/ is bind-mounted per RUN rather than COPYed. A `COPY vendor/ /vendor/`
# writes a ~1.9 GB layer, and the later `rm -rf /vendor` cannot reclaim it:
# layers are immutable, so the delete only adds a whiteout marker that hides the
# files while the bytes still ship with the image. Chained, that reached 3 dead
# layers (~5.8 GB) in the final image — invisible inside the container, but paid
# for in disk, in every registry push, and in build time on every rebuild.
# --mount=type=bind leaves no layer at all and copies nothing.

RUN --mount=type=bind,source=vendor,target=/vendor set -eux; \
    if [ -d /vendor/docker ]; then \
        install -m 0755 /vendor/docker/* /usr/local/bin/ && echo "docker engine: vendored from host"; \
    else \
        curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz" \
          | tar -xz -C /tmp && install -m 0755 /tmp/docker/* /usr/local/bin/ && echo "docker engine: downloaded"; \
    fi; \
    curl -fsSL -o /usr/local/bin/runc \
        "https://github.com/opencontainers/runc/releases/download/${RUNC_VERSION}/runc.amd64"; \
    chmod 0755 /usr/local/bin/runc

# The inner daemon's storage must NOT live on the sandbox's own overlayfs.
# containerd creates its snapshots as overlay mounts, and overlay-on-overlay
# fails with a bare "invalid argument": the daemon starts, reports healthy, and
# then every `docker run` dies at mount time. Declaring the volume makes Docker
# back this path with a real filesystem instead, which is why the official
# docker:dind image does the same thing.
VOLUME /var/lib/docker

COPY dind-entrypoint.sh /usr/local/bin/dind-entrypoint.sh
RUN chmod 0755 /usr/local/bin/dind-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/dind-entrypoint.sh"]
