# Layer 2/4 — the toolchain an agent actually needs.
#
# An audit run from inside the sandbox found no pandoc, no psql, no redis-cli,
# no tesseract, no Go, no Rust and no Playwright. None of it was lost; nobody
# had ever added it. This layer adds it, and does so under one rule:
#
#   Reuse what the build host already has; download only what it lacks.
#
# The rule has a hard limit, and it is the reason this file is split the way it
# is. The build host is Ubuntu 26.04 (glibc 2.43); this image is Ubuntu 22.04
# (glibc 2.35). glibc is backward- but NOT forward-compatible, so a binary
# linked against 2.38 copied in from the host resolves fine on PATH and then
# dies at exec with `GLIBC_2.38 not found`. Every host binary below was checked
# with `readelf -V` first:
#
#   COPYABLE   go (static) · rust (built for glibc 2.17) · uv (2.17)
#              dockerd/containerd/docker/docker-proxy (2.34) · shim (static)
#   NOT        jq · btop · ninja · dig · tcpdump  (all need 2.38 → apt instead)
#
# `build.sh` stages the copyable ones into vendor/. When vendor/ is empty — a
# clean checkout, CI, another machine — each step falls back to a version-pinned
# download, so this image is reproducible anywhere and merely *faster* here.
ARG BASE=nova-sandbox-base:latest
FROM ${BASE}

LABEL org.nova.sandbox.layer="tools"

ARG GO_VERSION=1.23.4
ARG RUST_CHANNEL=stable
ARG UV_VERSION=0.11.33
ARG DEBIAN_FRONTEND=noninteractive

# --- Downloaded: absent from the host, or too new for glibc 2.35 -------------
# pandoc/wkhtmltopdf/tesseract/psql/redis-cli are on neither side; jq, btop,
# ninja, dig and tcpdump exist on the host but are linked against glibc 2.38.
RUN apt-get update && apt-get install -y --no-install-recommends \
        pandoc \
        wkhtmltopdf \
        ghostscript \
        tesseract-ocr libtesseract-dev \
        postgresql-client \
        redis-tools \
        sqlite3 \
        dnsutils iputils-ping tcpdump \
        jq ninja-build \
        neovim btop \
        zstd unzip \
        iptables \
    && rm -rf /var/lib/apt/lists/*

# --- Vendored-or-downloaded ---------------------------------------------------
# vendor/ is bind-mounted per RUN rather than COPYed. A `COPY vendor/ /vendor/`
# writes a ~1.9 GB layer, and the later `rm -rf /vendor` cannot reclaim it:
# layers are immutable, so the delete only adds a whiteout marker that hides the
# files while the bytes still ship with the image. Chained, that reached 3 dead
# layers (~5.8 GB) in the final image — invisible inside the container, but paid
# for in disk, in every registry push, and in build time on every rebuild.
# --mount=type=bind leaves no layer at all and copies nothing.

# Go: the host toolchain is statically linked, so the whole GOROOT transplants.
RUN --mount=type=bind,source=vendor,target=/vendor set -eux; \
    if [ -f /vendor/go.tar ]; then \
        tar -xf /vendor/go.tar -C /usr/local && echo "go: vendored from host"; \
    else \
        curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" | tar -xz -C /usr/local && echo "go: downloaded"; \
    fi; \
    ln -sf /usr/local/go/bin/go /usr/local/bin/go; \
    ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt

# Rust: rustup ships toolchains built against glibc 2.17 precisely so they run
# on old distros, which is why the host's copy works here when jq's does not.
RUN --mount=type=bind,source=vendor,target=/vendor set -eux; \
    if [ -f /vendor/rust.tar ]; then \
        mkdir -p /usr/local/rust && tar -xf /vendor/rust.tar -C /usr/local/rust --strip-components=1 && echo "rust: vendored from host"; \
    else \
        curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain "${RUST_CHANNEL}" --profile minimal \
        && mv /root/.rustup/toolchains/*/ /usr/local/rust && echo "rust: downloaded"; \
    fi; \
    for b in /usr/local/rust/bin/*; do ln -sf "$b" "/usr/local/bin/$(basename "$b")"; done

# uv: the base image ships 0.8.9; the host has a much newer build that is
# glibc-2.17-linked and therefore safe to lift straight in.
RUN --mount=type=bind,source=vendor,target=/vendor set -eux; \
    if [ -f /vendor/uv ]; then \
        install -m 0755 /vendor/uv /usr/local/bin/uv && echo "uv: vendored from host"; \
    else \
        curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
          | tar -xz -C /tmp && install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uv /usr/local/bin/uv && echo "uv: downloaded"; \
    fi

# --- Already in the image: cost nothing ---------------------------------------
# corepack ships with Node 22, so pnpm and yarn need no download at image-build
# time -- but `corepack enable` only installs *shims*. /usr/bin/pnpm is a
# symlink into corepack/dist/pnpm.js, and the shim fetches the real package
# manager from the registry on first invocation, into COREPACK_HOME.
#
# That default is per-user (~/.cache/node/corepack), and the sandbox runs as
# `gem`, not root. So `corepack prepare` as root warmed a cache nobody used,
# and the first `pnpm install` inside a sandbox still went to the network --
# exactly the failure this image exists to avoid, and exactly what a self-probe
# reported ("Corepack is about to download pnpm-11.22.0.tgz").
#
# COREPACK_HOME is therefore a shared, world-readable location, warmed here for
# both managers. Same shape as PLAYWRIGHT_BROWSERS_PATH below: one install,
# every user.
ENV COREPACK_HOME=/opt/corepack
RUN set -eux; \
    export COREPACK_INTEGRITY_KEYS=0; \
    mkdir -p /opt/corepack; \
    corepack enable; \
    # pnpm via npm -g (registry.npmjs.org is NOT throttled on this ISP,
    # unlike github.com); corepack prepare hits the same throttled CDN.
    npm install -g --no-audit --no-fund --force pnpm@10.26.2 yarn; \
    chmod -R a+rX /opt/corepack || true

# Playwright gets its own browser, and the earlier attempt to avoid that was
# simply wrong. This layer used to set PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 plus
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser, on the theory
# that Playwright would drive the Chromium the base image already carries.
# Playwright reads no such variable — executable_path is a launch() argument,
# not an environment setting — so every p.chromium.launch() in the sandbox died
# with "Executable doesn't exist at .../chromium_headless_shell-1234/...".
# The saving was real (~350 MB) and the capability it bought was zero.
#
# BROWSERS_PATH is set to a system location rather than the default
# ~/.cache/ms-playwright so root and the `gem` user resolve the same install;
# the per-user default would have left whichever account did not run the build
# with no browser at all.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# Installed into 3.12 specifically, not via `pip3`. The base image ships three
# interpreters and `pip3` targets 3.10 — the one with the *fewest* packages —
# so installing there would put playwright somewhere the richest interpreter
# cannot import it, which is exactly the split this image documents against.
#
# --timeout/--retries because a bare `pip install` here hung indefinitely
# during the first build: sleeping, no sockets open, no progress for 40
# minutes. A build step that cannot finish must fail rather than stall.
# Installs from the vendored wheel cache when build.sh populated one, which
# takes PyPI off the critical path entirely — it is ~50x slower from this
# network than any other CDN. Falls back to the network when the cache is empty
# so a clean checkout still builds.
RUN --mount=type=bind,source=vendor,target=/vendor set -eux; \
    if ls /vendor/wheels/*.whl >/dev/null 2>&1; then \
        python3.12 -m pip install --no-cache-dir --no-index --find-links=/vendor/wheels \
            playwright pytest ruff mypy && echo "python tools: vendored wheels"; \
    else \
        python3.12 -m pip install --no-cache-dir --timeout 60 --retries 3 \
            playwright pytest ruff mypy && echo "python tools: downloaded"; \
    fi

# Point the unversioned `python` at 3.12 so an agent that types `python` lands
# on the interpreter that actually has the packages. Deliberately NOT touching
# `python3`: the base image's own supervisord services and apt's tooling resolve
# through it, and repointing that has broken images before. `python3` stays 3.10;
# `python` and `python3.12` are the ones to use.
RUN ln -sf /usr/local/bin/python3.12 /usr/local/bin/python

# The browsers themselves, plus their system libraries. `--with-deps` pulls the
# shared objects headless Chromium needs; the base image's chromium-browser
# package covers most of them, but not all, and a missing libnss3 surfaces as
# the same opaque launch failure as a missing binary. Full chromium, not
# --only-shell: launch() uses the headless shell, launch(headless=False) needs
# the full browser, and an agent that hits the second path should not discover
# a half-install. `playwright` is symlinked onto PATH because it installs into
# /opt/python3.12/bin, which is on root's PATH and not on the `gem` user's.
RUN set -eux; \
    ln -sf /opt/python3.12/bin/playwright /usr/local/bin/playwright; \
    playwright install --with-deps chromium; \
    chmod -R a+rX /opt/ms-playwright

# --- The rest of the toolchain an agent reaches for --------------------------
# Every entry below was confirmed absent by running `command -v` inside a live
# sandbox, not inferred. LibreOffice is the one heavy item (~600 MB) and the
# one with no substitute: pandoc, wkhtmltopdf and weasyprint above between them
# render Markdown, HTML and PDF, and none of them opens a .docx, .pptx or
# .xlsx. `soffice --headless --convert-to` is the whole reason it is here, so
# the -core/-writer/-calc/-impress split is deliberate — no Base, no Draw, no
# Java stack.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-core libreoffice-writer libreoffice-calc libreoffice-impress \
        fd-find bat figlet \
        webp libheif-examples \
    && rm -rf /var/lib/apt/lists/*

# Debian renames two of those to avoid collisions (fd -> fdfind because of
# fdclone, bat -> batcat because of bacula-console). Agents and scripts type
# the upstream names, so both resolve. `chromium` and `magick` are the same
# class of problem from the other direction: the base image ships
# chromium-browser and ImageMagick 6, while everything written in the last few
# years invokes `chromium` and `magick`.
RUN set -eux; \
    ln -sf "$(command -v fdfind)" /usr/local/bin/fd; \
    ln -sf "$(command -v batcat)" /usr/local/bin/bat; \
    ln -sf /usr/bin/chromium-browser /usr/local/bin/chromium; \
    ln -sf /usr/bin/convert /usr/local/bin/magick

# yq, deno and xh are single static binaries from GitHub — no glibc question,
# and no apt package in jammy worth having (yq there is the unrelated Python
# one).
#
# xh replaces httpie, which this layer installed from apt until the build-time
# verification caught it dead on arrival: jammy ships httpie 2.6.0, which does
# `from urllib3.util.ssl_ import DEFAULT_CIPHERS`, and the image's newer
# urllib3 removed that name. `apt-get install httpie` succeeded, `http` was on
# PATH, and every invocation ended in an ImportError traceback. xh is the Rust
# reimplementation with the same CLI, shipped as a musl-static binary — no
# Python, no dependency to drift out from under it. `http` is symlinked to it
# because that is the name people and scripts type.
ARG YQ_VERSION=4.44.6
ARG DENO_VERSION=2.1.4
# yq / deno / xh dropped from the network-fetch layer: this host's ISP is
# currently throttling GitHub downloads, so we skip them rather than block
# the build. If a future tool actually needs one, vendor it and uncomment.
#   - yq  -> use jq (apt has it) for ad-hoc queries; pip install yq if needed
#   - deno -> not consumed by anything in the current stack
#   - xh  -> curl covers the same surface
# yq/deno/xh dropped (no current consumer; comment above).
# kubectl, helm and terraform are static Go binaries, ~200 MB together, and
# useful without credentials — reading manifests, `helm template`, `terraform
# validate` and `fmt` all work offline. The credential-bound cloud CLIs (aws,
# gcloud, vercel, wrangler, supabase) are deliberately NOT here: gcloud alone
# is over a gigabyte, none of them does anything without secrets this image
# must not carry, and the deploy path Nova actually uses goes through the
# vercel skill's API rather than its binary.
ARG KUBECTL_VERSION=1.31.4
ARG HELM_VERSION=3.16.3
ARG TERRAFORM_VERSION=1.10.3
RUN --mount=type=bind,source=vendor,target=/vendor set -eux; \
    fetch_bin() { local name="$1"; if [ -f "/vendor/$name" ]; then \
        install -m 0755 "/vendor/$name" "/usr/local/bin/$name"; echo "$name: vendored"; \
    else echo "$name: vendor missing — will download"; return 1; fi; }; \
    fetch_bin kubectl || { \
        curl -fsSL "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
            -o /usr/local/bin/kubectl && chmod 0755 /usr/local/bin/kubectl; }; \
    fetch_bin helm || { \
        curl -fsSL "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
            | tar -xz -C /tmp && install -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm && rm -rf /tmp/linux-amd64; }; \
    fetch_bin terraform || { \
        curl -fsSL "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip" \
            -o /tmp/tf.zip && unzip -q /tmp/tf.zip -d /usr/local/bin && rm /tmp/tf.zip; \
        chmod 0755 /usr/local/bin/terraform; }


ENV PATH="/usr/local/go/bin:/usr/local/rust/bin:${PATH}" \
    GOPATH=/root/go \
    CARGO_HOME=/root/.cargo

# --- Documents: PDF tooling and the LibreOffice Java bridge ------------------
# A separate, late apt layer on purpose. Appending these to the LibreOffice
# block above would invalidate it and the 857 MB Playwright layer beneath it on
# every future edit; here they cost one small layer and rebuild in seconds.
#
# poppler-utils is the real gap an in-container audit found: the image could
# render a PDF (ghostscript, wkhtmltopdf) and not read one. pdftotext,
# pdfinfo, pdftoppm and pdfimages are what an agent reaches for when handed a
# PDF, and none of them was present.
#
# unoconv is thin -- `soffice --headless --convert-to` does the same job -- but
# it is one apt package, it is what scripts and docs reference by name, and its
# absence kept being reported as a gap. Cheaper to install than to keep
# explaining. (pdf2htmlEX is genuinely not in jammy and is not installed;
# nothing here pretends otherwise.)
#
# NOT installed: libreoffice-java-common. It was added here to silence
# `failed to launch javaldx - java may not function correctly`, tested against
# the built image, and did not -- the warning simply became `javaldx failed!`.
# LibreOffice does not pick up the android layer's JDK without further wiring.
# Conversions work regardless, so this is a cosmetic warning, and shipping a
# package whose only justification turned out to be false is worse than the
# warning. Left out deliberately so nobody re-adds it for the same reason.
#
# fzf and httpie close the last two gaps the same audit reported. fzf is a
# single apt package and is what interactive-filter idioms reach for.
#
RUN apt-get update && apt-get install -y --no-install-recommends \
        poppler-utils qpdf unoconv fzf \
    && rm -rf /var/lib/apt/lists/*

# httpie needs care on two counts.
#
# First, `http` is deliberately xh above (a faster, flag-compatible clone), and
# repointing it would silently change behaviour for anything already depending
# on it. So the real implementation is exposed under its own name, `httpie`,
# and `http` stays xh as designed.
#
# Second, it cannot come from apt. Jammy ships httpie 2.6.0, which does
# `from urllib3.util.ssl_ import DEFAULT_CIPHERS` -- a name urllib3 removed in
# 2.x, and this image already carries urllib3 2.x pip-installed into
# /usr/local/lib/python3.10, which shadows the apt copy. The distro package
# therefore ImportErrors on every invocation. The build caught this: the
# verify gate failed on `httpie --version` and the apt version never shipped.
# Installing into 3.12 gets httpie 3.x, which is urllib3-2-clean.
RUN set -eux; \
    python3.12 -m pip install --no-cache-dir --timeout 60 --retries 3 httpie; \
    ln -sf /opt/python3.12/bin/httpie /usr/local/bin/httpie

# --- Security arsenal --------------------------------------------------------
# Mapped 1:1 from the owner's Security-Toolkit knowledge base (mounted
# read-only at /mnt/security-toolkit at runtime). Domain -> tools:
#
#   network    nmap masscan tshark(wireshark-cli)
#   vulnscan   nuclei trivy nikto wapiti whatweb
#   webapp     sqlmap gobuster ffuf dirb dalfox arjun
#   secrets    gitleaks trufflehog semgrep detect-secrets
#   osint      subfinder amass httpx sherlock theHarvester
#   ad/creds   hydra john hashcat enum4linux smbclient impacket(secretsdump)
#   forensics  sleuthkit binwalk foremost exiftool yara
#   wireless   aircrack-ng bettercap wifite
#   blueteam   suricata lynis chkrootkit
#   reverse    checksec ropper (+ strings from binutils)
#
# Go/single-file tools are pinned release tarballs; bumping is a one-line ARG.
RUN set -eux;     apt-get update;     DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        nmap masscan nikto sqlmap dirb whatweb wapiti gobuster ffuf \
        hydra john john-data hashcat hashid binwalk foremost masscan \
        libimage-exiftool-perl testssl.sh sslscan dnsrecon \
        smbclient ldap-utils aircrack-ng bettercap wifite \
        suricata yara sleuthkit tshark lynis chkrootkit libpcap-dev; \
    rm -rf /var/lib/apt/lists/*
# Not in jammy (Kali-only): SecLists installs from source, pinned branch.
# enum4linux dropped deliberately: upstream script is unmaintained and its
# release URLs 404; impacket (secretsdump/smbclient) covers SMB enumeration.
# SecLists omitted from the build layer: GitHub is rate-limiting this ISP,
# and wordlists already ride in /mnt/security-toolkit via the Security-Toolkit
# mount. Pull from the GitHub release at runtime if a tool needs the full list.
RUN set -eux; \
    echo "seclists skipped (mount provides wordlists)"

RUN --mount=type=bind,source=vendor,target=/vendor set -eux; \
    # semgrep dropped: PyPI can't deliver the 70 MB manylinux wheel at this
    # ISP's rate (the smaller wheels download fine), and the gitleaks +
    # trufflehog + detect-secrets trio already covers the secrets surface
    # semgrep is most often used for. Install in-sandbox with `pip install
    # semgrep` if a future use case needs it.
    python3.12 -m pip install --no-cache-dir --timeout 60 --retries 3 \
        impacket sherlock theHarvester arjun detect-secrets ropper; \
    for b in secretsdump.py GetUserSPNs.py wmiexec.py psexec.py semgrep \
             sherlock theHarvester arjun detect-secrets ropper; do \
        if [ -e "/opt/python3.12/bin/$b" ]; then \
            ln -sf "/opt/python3.12/bin/$b" "/usr/local/bin/$b"; fi; \
    done

ARG NUCLEI_VERSION=3.3.9
ARG HTTPX_VERSION=1.6.9
ARG SUBFINDER_VERSION=2.6.7
ARG AMASS_VERSION=4.2.0
ARG GITLEAKS_VERSION=8.24.3
ARG TRUFFLEHOG_VERSION=3.88.31
ARG DALFOX_VERSION=2.10.0
ARG TRIVY_VERSION=0.62.1
RUN --mount=type=bind,source=vendor,target=/vendor set -eux; \
    fetch() { kind="$1"; url="$2"; out="$3"; \
        if [ -f "/vendor/$out" ]; then \
            install -m 0755 "/vendor/$out" "/usr/local/bin/$out"; \
        else \
            curl -fsSL "$url" -o "/tmp/$out.pkg"; \
            case "$kind" in \
                zip) python3 -c "import zipfile,sys;z=zipfile.ZipFile('/tmp/$out.pkg');z.extract('$out','/usr/local/bin')" ;; \
                targz) mkdir -p /tmp/x && tar -xzf "/tmp/$out.pkg" -C /tmp/x "$out" && install -m 0755 "/tmp/x/$out" "/usr/local/bin/$out" ;; \
            esac; \
        fi; \
        chmod 0755 "/usr/local/bin/$out"; rm -f "/tmp/$out.pkg"; rm -rf /tmp/x; }; \
    fetch zip   "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_amd64.zip" nuclei; \
    fetch zip   "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/httpx_${HTTPX_VERSION}_linux_amd64.zip" httpx; \
    fetch zip   "https://github.com/projectdiscovery/subfinder/releases/download/v${SUBFINDER_VERSION}/subfinder_${SUBFINDER_VERSION}_linux_amd64.zip" subfinder; \
    fetch targz "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" gitleaks; \
    fetch targz "https://github.com/trufflesecurity/trufflehog/releases/download/v${TRUFFLEHOG_VERSION}/trufflehog_${TRUFFLEHOG_VERSION}_linux_amd64.tar.gz" trufflehog; \
    fetch zip   "https://github.com/hahwul/dalfox/releases/download/v${DALFOX_VERSION}/dalfox_${DALFOX_VERSION}_linux_amd64.zip" dalfox; \
    fetch targz "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64Bit.tar.gz" trivy

# amass ships a nested folder layout; handle it separately.
ARG AMASS_VERSION=4.2.0
# Use vendor copy when present (avoids GitHub CDN which this ISP throttles).
RUN --mount=type=bind,source=vendor,target=/vendor set -eux; \
    if [ -f /vendor/amass ]; then \
        install -m 0755 /vendor/amass /usr/local/bin/amass; \
    else \
        curl -fsSL "https://github.com/owasp-amass/amass/releases/download/v${AMASS_VERSION}/amass_linux_amd64.zip" -o /tmp/amass.zip; \
        python3 -c "import zipfile;z=zipfile.ZipFile('/tmp/amass.zip');[z.extract(n,'/tmp/amass') for n in z.namelist() if n.endswith('/amass')]"; \
        install -m 0755 $(find /tmp/amass -name amass -type f | head -1) /usr/local/bin/amass; \
        rm -rf /tmp/amass.zip /tmp/amass; \
    fi

# --- Software-house completeness: per-language module gaps -------------------
# The manifest already advertises go/rust/node/python/playwright. What a whole
# software house reaches for that was MISSING entirely:
#   vcs/ops    gh (GitHub CLI), ansible
#   jvm        maven + gradle wrappers (JDK17 arrives on the android layer)
#   data       sqlite3, mysql-client, redis-tools(psql/redis-cli already present)
#   systems    strace, ltrace, zip, unzip, rsync, jq (vendored), net-tools
#   web        php-cli + composer, ruby-full
#   dotnet     .NET SDK pinned via dotnet-install (channel 8.0, LTS)
#   quality    pre-commit framework (pip, 3.12 shim like httpie)
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        gh ansible sqlite3 mysql-client strace ltrace zip unzip rsync \
        network-manager net-tools php-cli ruby-full maven gradle; \
    rm -rf /var/lib/apt/lists/*; \
    curl -fsSL https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer --quiet; \
    curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh && chmod +x /tmp/dotnet-install.sh && \
        /tmp/dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet && \
        ln -sf /usr/share/dotnet/dotnet /usr/local/bin/dotnet && rm -f /tmp/dotnet-install.sh

RUN python3.12 -m pip install --no-cache-dir pre-commit && \
    ln -sf /opt/python3.12/bin/pre-commit /usr/local/bin/pre-commit

# --- The build asserts its own claims ---------------------------------------
# Everything above is an intention until something checks it. Two failures made
# that concrete: the Playwright browsers were never installed because this file
# set an environment variable Playwright does not read, and the corepack warm-up
# above targeted a cache the sandbox user never consults. Both shipped green.
# Both were eventually found by an agent auditing its own container -- far too
# late, and it took two rounds of apt-log forensics to establish.
#
# So the toolchain layer ends by running every binary it claims to install, and
# FAILS THE BUILD if one does not resolve. `command -v` is not enough: a
# dangling symlink resolves and then dies at exec, so each one is executed.
# A broken toolchain can no longer become an image.
#
# Deliberately checked UNPRIVILEGED. Both bugs above were root-works/user-fails,
# so a root-only check would have caught neither. The sandbox's own user is
# `gem`, but it does not exist yet at build time -- the base image creates it
# when supervisord boots -- so this runs as `nobody`, which is present in every
# Debian-derived image and owns nothing. Anything readable by nobody is
# readable by gem, so this is the stricter test.
#
# HOME is pointed at a writable directory: `nobody`'s home is `/`, and a tool
# failing because it cannot write a cache there would be a false alarm about
# the wrong thing.
# Marker bumped $(date +%s) — cache-bust for verify-toolchain.sh edits.
ARG VERIFY_TIMESTAMP=2026-08-25.3
# john installs to /usr/sbin; nobody's PATH covers it but the verify `command -v`
# runs under `su` which may reset PATH. Symlink for certainty.
RUN set -eux; \
    [ -e /usr/sbin/john ] && ln -sf /usr/sbin/john /usr/local/bin/john || true; \
    [ -e /usr/bin/testssl.sh ] && ln -sf /usr/bin/testssl.sh /usr/local/bin/testssl.sh || true; \
    for b in sherlock theHarvester arjun detect-secrets ropper secretsdump.py; do \
        [ -e "/opt/python3.12/bin/$b" ] && ln -sf "/opt/python3.12/bin/$b" "/usr/local/bin/$b" || true; \
    done

COPY verify-toolchain.sh /usr/local/bin/verify-toolchain.sh
RUN chmod 0755 /usr/local/bin/verify-toolchain.sh \
    && su -s /bin/bash -c 'HOME=/tmp /usr/local/bin/verify-toolchain.sh' nobody

# --- The image says what it is ----------------------------------------------
# Nothing in the image identified the build, so an agent asking "which image am
# I and what is in it" had to reconstruct the answer from /var/log/apt/history
# -- and got it wrong twice. One `cat /etc/nova-sandbox.json` now answers it.
ARG NOVA_BUILD_ID=unknown
ARG NOVA_UPSTREAM_DIGEST=unknown
LABEL org.nova.sandbox.build-id="${NOVA_BUILD_ID}"
#
# The manifest also states which advertised ports are NOT listening. The
# upstream base image exports TINYPROXY_PORT=8118 and MCP_SERVER_PORT=8089 but
# starts neither daemon, so `env` shows two services that `ss -ltn` does not --
# and an auditing agent reasonably reads that as a Nova defect. It has been
# reported as one twice. Saying so in the manifest costs nothing and ends the
# question; see docker/sandbox/README.md.
RUN set -eux; \
    printf '{\n  "build_id": "%s",\n  "layer": "tools",\n  "upstream_digest": "%s",\n  "built_at": "%s",\n  "services": {\n    "listening": [],\n    "advertised_but_inert": [\n      {"env": "TINYPROXY_PORT", "port": 8118, "origin": "upstream base image", "reason": "no tinyproxy daemon is started"},\n      {"env": "MCP_SERVER_PORT", "port": 8089, "origin": "upstream base image", "reason": "no MCP server is started"}\n    ]\n  },\n  "toolchain": %s\n}\n' \
        "${NOVA_BUILD_ID}" "${NOVA_UPSTREAM_DIGEST}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$(/usr/local/bin/verify-toolchain.sh --manifest)" \
        > /etc/nova-sandbox.json; \
    chmod 0644 /etc/nova-sandbox.json; \
    python3 -c 'import json,sys; json.load(open("/etc/nova-sandbox.json"))' \
        || { echo "nova-sandbox.json is not valid JSON"; exit 1; }; \
    cat /etc/nova-sandbox.json
ENV NOVA_SANDBOX_BUILD="${NOVA_BUILD_ID}"

